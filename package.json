{
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "npx prisma generate",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/api/server.ts",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types prisma/seed.ts",
    "api": "node --env-file-if-exists=.env --experimental-strip-types src/api/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^6.19.3",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2"
  }
}
