// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FARMER
  CLIENT
  AGRO_MARKET
  LOGISTICS_PROVIDER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  CONFIRMED
}

enum FulfillmentType {
  FARMER_DELIVERY
  SELF_PICKUP
}

model User {
  id                 String             @id @default(cuid())
  email              String?            @unique
  phoneNumber        String?            @unique
  passwordHash       String?
  fullName           String
  avatarUrl          String?
  role               Role               @default(CLIENT)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  fcmToken           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  farmerProfile      FarmerProfile?
  orders             Order[]
  reviews            Review[]
  notifications      Notification[]
}

model FarmerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName           String
  about              String?
  avatarUrl          String?
  coverUrl           String?
  idCardFrontUrl     String?
  idCardBackUrl      String?
  region             String
  city               String?
  address            String?
  latitude           Float?
  longitude          Float?
  isDeliveryEnabled  Boolean            @default(true)
  isVatPayer         Boolean            @default(false)
  deliveryFee        Float              @default(0.0)
  deliveryCity       String?
  deliveryDays       String[]           @default([])
  regionalDeliveryFees Json?
  rating             Float              @default(5.0)
  reviewCount        Int                @default(0)
  totalRatings       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products           Product[]
  reviews            Review[]
}

model Product {
  id                 String             @id @default(cuid())
  farmerId           String
  farmer             FarmerProfile      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  category           String
  pricePerUnit       Float
  discountPercent    Int                @default(0)
  unit               String             @default("კგ")
  stockQuantity      Float              @default(0.0)
  stockStatus        String             @default("მარაგშია")
  minOrderQuantity   Float              @default(1.0)
  bulkDiscountMinQty Float?
  bulkDiscountPercent Int?
  rating             Float              @default(4.9)
  reviewCount        Int                @default(0)
  imageUrl           String?
  images             String[]           @default([])
  isAvailable        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  orderItems         OrderItem[]
}

model Order {
  id                   String             @id @default(cuid())
  clientId             String
  client               User               @relation(fields: [clientId], references: [id])
  farmerId             String?
  status               OrderStatus        @default(PENDING)
  totalAmount          Float
  deliveryFee          Float              @default(0.0)
  heavyFee             Float              @default(0.0)
  platformFee          Float              @default(0.0)
  paymentMethod        String             @default("ESCROW")
  isPickup             Boolean            @default(false)
  hasVat               Boolean            @default(false)
  fulfillmentType      FulfillmentType    @default(FARMER_DELIVERY)
  contactPerson        String?
  contactPhone         String?
  deliveryTimeWindow   String?
  deliveryAddress      String?
  deliveryNotes        String?
  cancellationReason   String?
  cancellationDeadline DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  items                OrderItem[]
  shipment             Shipment?
  review               Review?
}

model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  senderId   String
  senderRole String   @default("customer")
  senderName String
  text       String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id                 String             @id @default(cuid())
  orderId            String
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product            @relation(fields: [productId], references: [id])
  quantity           Float
  pricePerUnit       Float
  subtotal           Float
}

model Shipment {
  id                 String             @id @default(cuid())
  orderId            String             @unique
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status             ShipmentStatus     @default(PENDING)
  trackingNumber     String?            @unique
  carrierId          String?
  agroMarketLocationId String?
  pickupWindowStart  DateTime?
  pickupWindowEnd    DateTime?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  String   @default("orders")
  isRead    Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Review {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  clientId  String
  client    User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  farmerId  String
  farmer    FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  rating    Int           @default(5)
  tags      String[]      @default([])
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([farmerId, createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}



